# ===================================================
# Discord Bot Configuration
# ===================================================

# Токен бота из Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# ID приложения (General Information -> Application ID)
CLIENT_ID=your_client_id_here

# (Опционально) ID тестового сервера для мгновенной регистрации слэш-команд
# Если не указан, команды регистрируются глобально (может занять до нескольких минут)
GUILD_ID=

# Порог неактивности в днях (по умолчанию 30)
INACTIVITY_DAYS=30

# Интервал автоматической проверки в часах (по умолчанию 12)
CHECK_INTERVAL_HOURS=12

# Режим тестирования (true = только отчеты в консоль/канал БЕЗ фактического кика, false = реальный кик)
# РЕКОМЕНДУЕТСЯ сначала запустить с true, чтобы проверить список кандидатов!
DRY_RUN=true

# (Опционально) ID канала Discord, куда бот будет слать отчеты о проверках
LOG_CHANNEL_ID=

# (Опционально) Дополнительные ID ролей с иммунитетом через запятую (модераторы и бустеры уже защищены по умолчанию)
IMMUNE_ROLE_IDS=1447298868323549435,1553082516531970088

# Путь к файлу SQLite базы данных
DB_PATH=./data/activity.db

# Порт для HTTP Health Check сервера (Render автоматически подставляет свой)
PORT=3000

# Статус активности бота (отображается как "Играет в ...")
BOT_ACTIVITY=donate.ebalbox.tech
